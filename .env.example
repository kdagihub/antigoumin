# Copier vers .env et adapter les valeurs
# cp .env.example .env

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,antigoumin-api.ciacems.site,api.antigoumin.live

# --- CORS / CSRF ---
# Origines frontend + domaines API (admin Django servi sur l'API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://antigoumin.ciacems.site,https://antigoumin.live,https://www.antigoumin.live
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://antigoumin.ciacems.site,https://antigoumin.live,https://www.antigoumin.live,https://antigoumin-api.ciacems.site,https://api.antigoumin.live

# --- JWT ---
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Base de données ---
# Dokploy : utiliser DATABASE_URL (recommandé)
DATABASE_URL=postgres://antigoumin:change-me@db:5432/antigoumin

# Fallback local si DATABASE_URL absent :
# POSTGRES_DB=antigoumin
# POSTGRES_USER=antigoumin
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/1

# --- Serveur ---
BACKEND_PORT=8000
FRONTEND_BASE_URL=http://localhost:5173

# En production :
# FRONTEND_BASE_URL=https://antigoumin.live
# VITE_API_BASE_URL=https://api.antigoumin.live

# --- SMS Zavu (https://docs.zavu.dev/guides/sending-messages/sms) ---
ZAVU_API_KEY=
ZAVU_SENDER_ID=
ZAVU_API_BASE_URL=https://api.zavu.dev

# --- Email SMTP Hostinger ---
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=contact@antigoumin.live
EMAIL_PASSWORD=
EMAIL_USE_SSL=True
CONTACT_EMAIL=contact@antigoumin.live
PRIVACY_EMAIL=privacy@antigoumin.live
DEFAULT_FROM_EMAIL=AntiGoumin <contact@antigoumin.live>
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# --- Déclarations / abonnement ---
VERIFICATION_TOKEN_TTL_MINUTES=15
VERIFICATION_ACCESS_TTL_HOURS=24
TRANSPARENCY_REQUEST_TTL_HOURS=48
TRANSPARENCY_REQUEST_COOLDOWN_HOURS=168
SUBSCRIPTION_DURATION_DAYS=30
SMS_RATE_LIMIT_PER_HOUR=5
MAX_UPLOAD_IMAGE_SIZE=5242880
PAYMENT_WEBHOOK_SECRET=change-me

# --- GeniusPay ---
# Sandbox : https://geniuspay.ci/api/v1/merchant
# Docs : https://geniuspay.ci/docs/api
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_ENVIRONMENT=sandbox
GENIUSPAY_WEBHOOK_SECRET=

# --- Build frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=

# --- Images Docker Hub ---
BACKEND_IMAGE=ciacems/agm:backend-latest
FRONTEND_IMAGE=ciacems/agm:frontend-latest
