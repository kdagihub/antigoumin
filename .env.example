# Copier vers .env et adapter les valeurs
# cp .env.example .env

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,antigoumin-api.ciacems.site,api.antigoumin.net

# --- CORS / CSRF ---
# Origines frontend + domaines API (admin Django servi sur l'API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://antigoumin.ciacems.site,https://antigoumin.net
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://antigoumin.ciacems.site,https://antigoumin.net,https://antigoumin-api.ciacems.site,https://api.antigoumin.net

# --- JWT ---
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Base de données ---
# Dokploy : utiliser DATABASE_URL (recommandé)
DATABASE_URL=postgres://antigoumin:change-me@db:5432/antigoumin

# Fallback local si DATABASE_URL absent :
# POSTGRES_DB=antigoumin
# POSTGRES_USER=antigoumin
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/1

# --- Serveur ---
BACKEND_PORT=8000

# --- Build frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=

# --- Images Docker Hub ---
BACKEND_IMAGE=ciacems/agm:backend-latest
FRONTEND_IMAGE=ciacems/agm:frontend-latest
